# Copy this file to secrets.yml and fill in your actual values.
# Do NOT commit secrets.yml — it is gitignored.
# URLs use Docker service names because Recyclarr runs in a container.

sonarr_apikey: YOUR_SONARR_API_KEY_HERE
sonarr_url: http://sonarr:8989

radarr_apikey: YOUR_RADARR_API_KEY_HERE
radarr_url: http://radarr:7878
