<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danteb.studio-ollama</string>
    <key>UserName</key>
    <string>_studio</string>
    <key>WorkingDirectory</key>
    <string>/var/lib/studio-worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/ollama/bin/ollama</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/lib/studio-worker</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>OLLAMA_HOST</key>
        <string>127.0.0.1:11434</string>
        <key>OLLAMA_MODELS</key>
        <string>/var/lib/studio-worker/ollama/models</string>
        <key>OLLAMA_NO_CLOUD</key>
        <string>1</string>
        <key>OLLAMA_NUM_PARALLEL</key>
        <string>1</string>
        <key>OLLAMA_MAX_LOADED_MODELS</key>
        <string>1</string>
        <key>OLLAMA_MAX_QUEUE</key>
        <string>4</string>
        <key>OLLAMA_CONTEXT_LENGTH</key>
        <string>4096</string>
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>5m</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/lib/studio-worker/logs/ollama.log</string>
    <key>StandardErrorPath</key>
    <string>/var/lib/studio-worker/logs/ollama-error.log</string>
</dict>
</plist>
