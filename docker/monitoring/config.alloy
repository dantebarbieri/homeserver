// Grafana Alloy configuration — Docker log collection → Loki
// Replaces Promtail (EOL March 2026)

// Discover all Docker containers through Alloy's read-only socket broker
// (alloy-socket-proxy in compose.monitoring.yml); Alloy has no socket mount.
discovery.docker "containers" {
  host = "tcp://alloy-socket-proxy:2375"
}

// Extract container metadata as labels
discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  // This service intentionally retains no logs because errors can contain capabilities.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "mirklurk-map-uploads"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
    regex         = "/(.*)"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

// Collect logs from Docker containers via the same broker. Tailing needs
// container inspect plus logs; a 403 in alloy-socket-proxy's logs means the
// allowlist is missing an endpoint.
loki.source.docker "containers" {
  host       = "tcp://alloy-socket-proxy:2375"
  targets    = discovery.relabel.docker.output
  forward_to = [loki.write.local.receiver]
}

// Ship logs to Loki
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
