FROM ghcr.io/c4illin/convertx:latest

# Upstream installs imagemagick-7.q16 with --no-install-recommends, which skips
# the "extra" coders package. Without it ImageMagick has no SVG coder, falls
# back to a missing rsvg-convert delegate, and every SVG conversion fails with
# "no decode delegate for this image format `SVG'".
# See: https://github.com/C4illin/ConvertX/issues/323
#
# The package name embeds the libmagickcore ABI version, so derive it from the
# base image instead of hardcoding it.
RUN set -eu; \
    core="$(dpkg-query -W -f='${Package}\n' 'libmagickcore-7.q16-[0-9]*' | grep -v -- '-extra$' | head -n1)"; \
    [ -n "$core" ]; \
    apt-get update; \
    apt-get install -y --no-install-recommends "${core}-extra"; \
    rm -rf /var/lib/apt/lists/*; \
    magick -list format | grep -qw SVG
