FROM jellyfin/jellyfin:latest

# Patch index.html to inject integrity-checked Finity "Complete" theme assets.
# See: https://github.com/prism2001/finity#installation
# Update each integrity hash with its pinned asset; the CSS still imports Google Fonts.
RUN sed -i 's|</head>|<script src="https://cdn.jsdelivr.net/npm/marked@15.0.11/marked.min.js" integrity="sha384-y8zv/gOzlx/9tuZY353SDS6qzs+VETozJn1zi0aOAssCDCUWznjXyzrchNLn6PTA" crossorigin="anonymous"></script><script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.5/dist/purify.min.js" integrity="sha384-qSFej5dZNviyoPgYJ5+Xk4bEbX8AYddxAHPuzs1aSgRiXxJ3qmyWNaPsRkpv/+x5" crossorigin="anonymous"></script><script async src="https://cdn.jsdelivr.net/gh/prism2001/finity@88ccf3d2e133568f9c2e5d1a75bc662ba811d2b1/clickableTitles.js" integrity="sha384-HT+2rgM+ssSh/1rb2sI9Xbtj34GH1wItrpkVeczNK4fwqPpAEC8DW5YwwKhV6wLL" crossorigin="anonymous"></script><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/prism2001/finity@88ccf3d2e133568f9c2e5d1a75bc662ba811d2b1/complete/slideshowpure.css" integrity="sha384-pheQVb7QjepMwHCmXvD1f9EzkEomQITdktnFH2h0gFd8ezxoFS4Vs8nqxTaixuJw" crossorigin="anonymous" /><script defer src="https://cdn.jsdelivr.net/gh/prism2001/jellyfin-featured-slideshow@9b6b58129c9380c87ec3aff4662ebad6b59fd7cf/slideshowpure.js" integrity="sha384-s45J976I5Ihs5aHGWl0H79pTufTJLBqElwNULSsFrRlrlg9YzgD9fQXSr0ZcaiZC" crossorigin="anonymous"></script></head>|' /jellyfin/jellyfin-web/index.html
