# ==============================================================================
# Canonical layout for docker/.env: keep sections, comments and key order in sync.
# Never put real credentials in this template. See docs/ENVIRONMENT.md for the
# names-only inventory, private backups and value-preserving reconciliation.
#
# Compose dotenv syntax, NOT a shell script:
# Single quotes keep $ and other special characters literal: KEY='example$token'
# Double-quoted and unquoted values support Compose interpolation.
# Do not source this file or print resolved Compose configuration with real keys.
# ==============================================================================

# ==============================================================================
# Shared settings - identity, storage and repository paths
# ==============================================================================
UID=1000
GID=1000
TZ=America/Chicago
DATA=/srv/docker/data
RAID=/data
# Docker group GID for socket consumers: getent group docker | cut -d: -f3
DOCKER_GID=999
REPO_PATH=/srv/homeserver
HOMEPAGE_CONFIG_PATH=/srv/homeserver/homepage
# External repositories used by build contexts and service mounts.
TRAVEL_PLANNER_PATH=/srv/travel-planner
RECIPE_APP_PATH=/srv/docker/recipe-app
SKYJO_PATH=/srv/skyjo
SORRY_PATH=/srv/sorry-game
MIRKLURK_WIKI_PATH=/srv/docker/mirklurk-wiki
# Shared archive mount used by qBittorrent; retain even without OpenClaw running.
OPENCLAW_V3_BASE=/data/openclaw-v3

# ==============================================================================
# Core and authentication - BMC IP monitor / Nginx Proxy Manager
# Authelia credentials are files under ${DATA}/authelia/secrets/, not env values.
# See compose.auth.yml. The BMC monitor uses these NPM login credentials.
# ==============================================================================
NPM_EMAIL=admin@example.com
NPM_PASSWORD=''

# ==============================================================================
# Downloads - Gluetun / qBittorrent
# ==============================================================================
WG_PRIVATE_KEY=''
WG_ADDRESS=
SERVER_COUNTRY="United States"
SERVER_CITIES=Austin,Dallas,Houston
QUSER=''
QPASS=''

# ==============================================================================
# Downloads - slskd / second ProtonVPN tunnel
# Create a second WireGuard config at account.protonvpn.com > Downloads >
# WireGuard with NAT-PMP enabled; one forwarded port is available per tunnel.
# ==============================================================================
SLSKD_WG_PRIVATE_KEY=''
SLSKD_WG_ADDRESS=
# Soulseek creates the account on first login if the username is free.
# Generate independent secrets with: openssl rand -base64 48
SLSKD_SLSK_USERNAME=''
SLSKD_SLSK_PASSWORD=''
SLSKD_WEB_USERNAME=''
SLSKD_WEB_PASSWORD=''
SLSKD_JWT_KEY=''
# Primary API key (16-255 chars), shared with Soularr and Homepage.
SLSKD_API_KEY=''

# ==============================================================================
# Downloads - FlareSolverr (defaults match compose.downloads.yml)
# ==============================================================================
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none

# ==============================================================================
# Networking - wg-easy (WireGuard VPN server)
# ==============================================================================
WGEASY_HOST=vpn.example.com
# Generate with: docker run ghcr.io/wg-easy/wg-easy wgpw 'YOUR_PASSWORD'
# Single-quote bcrypt hashes because they contain $ signs.
WGEASY_PASSWORD_HASH=''

# ==============================================================================
# Media - Immich
# https://immich.app/docs/install/environment-variables
# ==============================================================================
UPLOAD_LOCATION=/data/immich
IMMICH_VERSION=release
DB_PASSWORD=''
# Internal defaults; do not rename these without updating Compose as well.
DB_HOSTNAME=immich_postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
REDIS_HOSTNAME=immich_redis

# ==============================================================================
# Media - Plex
# ==============================================================================
# Obtain a short-lived claim token from https://www.plex.tv/claim/.
PLEX_CLAIM=claim-xxxxxx
ADVERTISE_IP=http://<hostIPAddress>:32400/

# ==============================================================================
# Media - Storyteller / libro.fm / BookBridge (see docs/AUDIOBOOKS.md)
# ==============================================================================
STORYTELLER_SECRET_KEY=''  # Generate with: openssl rand -base64 32
LIBRO_FM_USERNAME=''
LIBRO_FM_PASSWORD=''
# NPM's IPv4 and IPv6 on the proxy network, comma-separated. Find them with:
#   docker inspect -f '{{with index .NetworkSettings.Networks "compose_proxy"}}{{.IPAddress}},{{.GlobalIPv6Address}}{{end}}' nginxproxymanager
# Empty is safe: devices share NPM's login rate-limit bucket.
BOOKBRIDGE_KOSYNC_TRUSTED_PROXIES=''

# ==============================================================================
# Media - Suwayomi / Postgres
# ==============================================================================
SUWAYOMI_USER=suwayomi
SUWAYOMI_PASS=''
SUWAYOMI_DB=suwayomi_db

# ==============================================================================
# Media - RomM (ROM library manager)
# Generate each secret separately with: openssl rand -hex 32
# ==============================================================================
ROMM_DB_ROOT_PASSWORD=''
ROMM_DB_PASSWORD=''
ROMM_AUTH_SECRET_KEY=''
# Optional metadata providers; Hasheous needs no credentials by default.
ROMM_IGDB_CLIENT_ID=''
ROMM_IGDB_CLIENT_SECRET=''
ROMM_SCREENSCRAPER_USER=''
ROMM_SCREENSCRAPER_PASSWORD=''
ROMM_STEAMGRIDDB_API_KEY=''
ROMM_RETROACHIEVEMENTS_API_KEY=''

# ==============================================================================
# Media - Tdarr
# ==============================================================================
TDARR_API_KEY=''

# ==============================================================================
# Git - Forgejo / Actions runner
# ==============================================================================
FORGEJO_DB_PASSWORD=''
LFS_JWT_SECRET=''  # Generate with: openssl rand -base64 32
# Idempotent runner registration secret: openssl rand -hex 20 (exactly 40 chars).
# After first set, register once on the server with:
#   docker exec forgejo forgejo forgejo-cli actions register \
#       --name homeserver-runner --secret "$FORGEJO_RUNNER_SECRET"
# Then enter the printed UUID and secret in
# ${DATA}/forgejo_runner/runner-config.yml (server.connections.forgejo).
FORGEJO_RUNNER_SECRET=''

# ==============================================================================
# Collaboration - Nextcloud
# ==============================================================================
NEXTCLOUD_HOSTNAME=cloud.example.com
NEXTCLOUD_DB_PASSWORD=''
# Used only on first startup to create the admin account.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=''

# ==============================================================================
# Collaboration - Matrix / Synapse / Coturn / LiveKit
# ==============================================================================
SYNAPSE_SERVER_NAME=example.com
SYNAPSE_DB_PASSWORD=''
# Must also match turnserver.conf and homeserver.yaml (see MATRIX.md).
COTURN_AUTH_SECRET=''
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=''

# ==============================================================================
# Monitoring - Grafana
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=''

# ==============================================================================
# Dashboards - Homepage service widget credentials
# See homepage/WIDGET_API_KEYS.md; Compose must explicitly pass each variable.
# ==============================================================================
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com
HOMEPAGE_VAR_PLEX_TOKEN=''
HOMEPAGE_VAR_JELLYFIN_KEY=''
HOMEPAGE_VAR_SEERR_KEY=''
HOMEPAGE_VAR_IMMICH_KEY=''
HOMEPAGE_VAR_KOMGA_USER=''
HOMEPAGE_VAR_KOMGA_PASS=''
HOMEPAGE_VAR_RADARR_KEY=''
HOMEPAGE_VAR_SONARR_KEY=''
HOMEPAGE_VAR_LIDARR_KEY=''
HOMEPAGE_VAR_BAZARR_KEY=''
HOMEPAGE_VAR_PROWLARR_KEY=''
HOMEPAGE_VAR_SABNZBD_KEY=''
HOMEPAGE_VAR_NPM_USER=''
HOMEPAGE_VAR_NPM_PASS=''
HOMEPAGE_VAR_TDARR_KEY=''
HOMEPAGE_VAR_QBIT_USER=''
HOMEPAGE_VAR_QBIT_PASS=''
HOMEPAGE_VAR_NEXTCLOUD_USER=''
HOMEPAGE_VAR_NEXTCLOUD_PASS=''
HOMEPAGE_VAR_ADGUARD_USERNAME=''
HOMEPAGE_VAR_ADGUARD_PASSWORD=''
HOMEPAGE_VAR_KUMA_SLUG=''
HOMEPAGE_VAR_GRAFANA_USER=''
HOMEPAGE_VAR_GRAFANA_PASS=''
HOMEPAGE_VAR_CALIBRE_USER=''
HOMEPAGE_VAR_CALIBRE_PASS=''
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=''
# UI_LOGIN account shared with the internal suwayomi-widget adapter.
HOMEPAGE_VAR_SUWAYOMI_USER=''
HOMEPAGE_VAR_SUWAYOMI_PASS=''
HOMEPAGE_VAR_HARDCORE_MC_IP_OR_DOMAIN=''
HOMEPAGE_VAR_HARDCORE_MC_PORT=25565
HOMEPAGE_VAR_MATCHA_MC_IP_OR_DOMAIN=''
HOMEPAGE_VAR_MATCHA_MC_PORT=25565
HOMEPAGE_VAR_RLCRAFT_MC_IP_OR_DOMAIN=''
HOMEPAGE_VAR_RLCRAFT_MC_PORT=25565
HOMEPAGE_VAR_CHANGEDETECTION_KEY=''

# ==============================================================================
# Utilities - SearXNG
# ==============================================================================
SEARXNG_HOSTNAME=
SEARXNG_SECRET_KEY=''  # Generate with: openssl rand -hex 32

# ==============================================================================
# Utilities - CouchDB / Obsidian Self-hosted LiveSync
# https://github.com/vrtmrz/obsidian-livesync; see docs/OBSIDIAN-LIVESYNC.md.
# These admin credentials are also used in the LiveSync client.
# ==============================================================================
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=''  # Generate with: openssl rand -hex 24 (URL-safe)

# ==============================================================================
# Utilities - ConvertX / Changedetection.io
# ==============================================================================
CONVERTX_JWT_SECRET=''  # Generate with: openssl rand -base64 32
CHANGEDETECTION_HOSTNAME=cd.danteb.com

# ==============================================================================
# Gaming - Minecraft / CurseForge
# ==============================================================================
CF_API_KEY=''

# ==============================================================================
# Websites - MirkLurk wiki
# Credentials are files in ${DATA}/mirklurk/secrets/, never env values.
# See docs/MIRKLURK.md for installation and approved branding artwork.
# ==============================================================================
MIRKLURK_SERVER_URL=https://wiki.mirklurk.danteb.com
# Verified proxy address(es), comma-separated /32 or /128; never trust all IPs.
MIRKLURK_TRUSTED_PROXY_CIDRS=
# Public root-relative PNG URLs; set both logos together. Empty keeps defaults.
# Provision the read-only branding directory before setting these.
MIRKLURK_LOGO_URL=
MIRKLURK_LOGO_ICON_URL=
MIRKLURK_FAVICON_URL=
# Optional opaque 180 x 180 PNG for iOS home-screen bookmarks.
MIRKLURK_APPLE_TOUCH_ICON_URL=
# Nonempty maintenance reason freezes web edits.
MIRKLURK_READ_ONLY=

# ==============================================================================
# Websites - Skyjo
# ==============================================================================
SKYJO_DB_PASSWORD=''  # Generate with: openssl rand -hex 32 (URL-safe)
SKYJO_JWT_SECRET=''   # Generate with: openssl rand -base64 32

# ==============================================================================
# Retained integrations - AI providers / gateways / Open WebUI / AI SearXNG
# These keys are retained from production, not directly referenced by the current
# Compose files. Do not delete or rotate them as part of layout reconciliation;
# external configuration or tooling may still depend on them.
# ==============================================================================
ANTHROPIC_API_KEY=''
LITELLM_MASTER_KEY=''
LITELLM_SALT_KEY=''
LITELLM_DB_PASSWORD=''
LITELLM_API_KEY_OPENWEBUI=''
LITELLM_API_KEY_ROUTER=''
LLMROUTER_API_KEY=''
OPENWEBUI_SECRET_KEY=''
SEARXNG_AI_HOSTNAME=
SEARXNG_AI_SECRET_KEY=''

# ==============================================================================
# Retained integrations - Aurral
# Not directly consumed from .env by the current Compose files.
# ==============================================================================
AURRAL_USERNAME=''
AURRAL_PASSWORD=''

# ==============================================================================
# Retained integrations - Grocy automation
# Defaults are intentionally unspecified; preserve existing production values.
# ==============================================================================
GROCY_API_KEY=''
GROCY_AUTOCONSUME_DIGEST=
GROCY_AUTOCONSUME_GROUP=
GROCY_AUTOCONSUME_TIME=
GROCY_NTFY_TOPIC=
GROCY_NTFY_URL=
GROCY_POLL_INTERVAL=

# ==============================================================================
# Retained integrations - location / map data
# Not directly consumed from .env by the current Compose files.
# ==============================================================================
NOMINATIM_PASSWORD=''
NOMINATIM_REPLICATION_URL=
OVERTURE_RELEASE=
PHOTON_DOWNLOAD_URL=
WIKIMEDIA_USER_AGENT=

# Other file secrets: mcp-tcad uses ${DATA}/mcp/secrets/MCP_TOKEN_TCAD, declared
# under Docker secrets in docker-compose.yml, rather than a value in this file.
